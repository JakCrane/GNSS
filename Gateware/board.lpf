LOCATE COMP "clk" SITE "91";
IOBUF PORT "clk" IO_TYPE=LVCMOS33;

FREQUENCY PORT "clk" 16.368 MHZ;



LOCATE COMP "mcu_irq" SITE "23"; // output
IOBUF PORT "mcu_irq" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;

LOCATE COMP "mcu_miso" SITE "18"; // output
IOBUF PORT "mcu_miso" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;

LOCATE COMP "mcu_sck" SITE "14"; // input
IOBUF PORT "mcu_sck" IO_TYPE=LVCMOS33;

LOCATE COMP "mcu_mosi" SITE "19"; // input
IOBUF PORT "mcu_mosi" IO_TYPE=LVCMOS33;

LOCATE COMP "mcu_cs" SITE "24"; // input
IOBUF PORT "mcu_cs" IO_TYPE=LVCMOS33 PULLMODE=UP;



LOCATE COMP "rf_shdn_n" SITE "105"; // output
IOBUF PORT "rf_shdn_n" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;

LOCATE COMP "rf_idle_n" SITE "79"; // output
IOBUF PORT "rf_idle_n" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;

LOCATE COMP "rf_ld" SITE "106"; // input
IOBUF PORT "rf_ld" IO_TYPE=LVCMOS33;